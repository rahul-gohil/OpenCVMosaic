# Copy this file to .env and fill in your values.
# The orchestrator loads .env automatically on startup, or you can use:
#   set -a; source .env; set +a
#
# Do NOT put AWS secret keys in this file. Use a named profile
# (~/.aws/credentials), environment variables, or AWS SSO instead.

# Region that contains the COOL Graviton5 AMI and your key pair.
AWS_DEFAULT_REGION=us-east-1

# Existing EC2 key pair name in that region.
EC2_KEY_PAIR_NAME=your-key-pair

# Private key file used by the orchestrator for SSH/SCP and shown in the UI.
EC2_KEY_PATH=/home/you/.ssh/your-key.pem

# COOL Marketplace AMI (Graviton5, Ubuntu 24.04). Required for all modes.
MARKETPLACE_AMI_ID=ami-xxxxxxxxxxxxxxxxx

# Optional hardening: restrict ports 8080/22 on the benchmark security group
# to your own address instead of the whole internet.
# BENCHMARK_ALLOWED_CIDR=203.0.113.7/32

# Optional: also download full-resolution chunk JPEGs during the benchmark
# (much slower on a thin uplink; defaults to preview-only).
# DOWNLOAD_FULL_CHUNKS=0

# Optional: pin launches to one subnet/AZ. By default the orchestrator tries
# every subnet and fails over on InsufficientInstanceCapacity.
# EC2_SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx
