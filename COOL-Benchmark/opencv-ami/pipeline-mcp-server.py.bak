#!/usr/bin/env python3
"""
Pipeline MCP Server - Runs on EC2 instances (Graviton5 with COOL AMI).
Receives pipeline job specs via HTTP POST and runs the orthomosaic pipeline.

This replaces opencv-mcp-server.py which only ran findContours on individual
images.  Instead, it runs the full pipeline (chunk stitching + merge) on a
dataset and returns per-stage metrics.

Endpoints:
    GET  /health          - Health check
    POST /run-pipeline    - Run the full pipeline, return metrics
"""

import asyncio
import json
import logging
import os
import sys
import time
import subprocess
import base64
from aiohttp import web

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    handlers=[
        logging.StreamHandler(sys.stdout),
        logging.FileHandler('/var/log/pipeline-mcp.log'),
    ],
)
logger = logging.getLogger("pipeline-mcp-server")

# OpenCV availability check
try:
    import cv2
    OPENCV_AVAILABLE = True
    logger.info(f"OpenCV {cv2.__version__} loaded from {cv2.__file__}")
    if '/opt/cool' in cv2.__file__:
        logger.info("Using COOL optimized OpenCV build")
    else:
        logger.info("Using standard OpenCV build")
except ImportError as e:
    OPENCV_AVAILABLE = False
    logger.error(f"OpenCV not available: {e}")

# Pipeline code location
PIPELINE_DIR = os.environ.get("PIPELINE_DIR", "/opt/OpenCVMosaic")
PYTHON = os.environ.get("PYTHON", "python3")


async def handle_health(request):
    """Health check endpoint."""
    return web.json_response({
        "status": "healthy",
        "opencv_available": OPENCV_AVAILABLE,
        "opencv_version": cv2.__version__ if OPENCV_AVAILABLE else None,
        "opencv_path": cv2.__file__ if OPENCV_AVAILABLE else None,
        "is_cool": "/opt/cool" in (cv2.__file__ if OPENCV_AVAILABLE else ""),
    })


async def handle_run_pipeline(request):
    """Run the full orthomosaic pipeline and return metrics."""
    try:
        data = await asyncio.wait_for(request.json(), timeout=60)
        s3_input = data.get("s3_input", "")
        s3_output = data.get("s3_output", "")
        chunk_size = data.get("chunk_size", 18)
        work_dir = data.get("work_dir", "/tmp/scratchpad")

        if not s3_input or not s3_output:
            return web.json_response(
                {"error": "s3_input and s3_output are required"}, status=400
            )

        logger.info(f"Received pipeline request: input={s3_input}, output={s3_output}, chunk_size={chunk_size}")

        start = time.perf_counter()

        # Step 1: Download dataset from S3
        input_dir = os.path.join(work_dir, "input")
        os.makedirs(input_dir, exist_ok=True)
        dl_start = time.perf_counter()
        proc = subprocess.run(
            ["aws", "s3", "sync", s3_input, input_dir],
            capture_output=True, text=True,
        )
        if proc.returncode != 0:
            return web.json_response(
                {"error": f"S3 download failed: {proc.stderr[-500:]}"}, status=500
            )
        dl_time = time.perf_counter() - dl_start

        # Step 2: Run chunked stitching
        stitch_start = time.perf_counter()
        proc = subprocess.run(
            [PYTHON, "main.py", "run-chunks",
             "--dataset", input_dir,
             "--chunk-size", str(chunk_size),
             "--output-root", os.path.join(work_dir, "chunks"),
             "--prefix", "chunk"],
            cwd=PIPELINE_DIR, capture_output=True, text=True,
        )
        if proc.returncode != 0:
            logger.error(f"Stitch failed: {proc.stderr[-500:]}")
            return web.json_response(
                {"error": f"Stitch failed: {proc.stderr[-500:]}"}, status=500
            )
        stitch_time = time.perf_counter() - stitch_start

        # Step 3: Run merge
        merge_start = time.perf_counter()
        chunk_pattern = os.path.join(work_dir, "chunks", "chunk_*", "mosaic_final.jpg")
        proc = subprocess.run(
            [PYTHON, "main.py", "merge",
             "--inputs", chunk_pattern,
             "--out", os.path.join(work_dir, "merged")],
            cwd=PIPELINE_DIR, capture_output=True, text=True,
        )
        if proc.returncode != 0:
            logger.error(f"Merge failed: {proc.stderr[-500:]}")
            return web.json_response(
                {"error": f"Merge failed: {proc.stderr[-500:]}"}, status=500
            )
        merge_time = time.perf_counter() - merge_start

        # Step 4: Upload results to S3
        ul_start = time.perf_counter()
        proc = subprocess.run(
            ["aws", "s3", "sync", os.path.join(work_dir, "merged"), s3_output],
            capture_output=True, text=True,
        )
        if proc.returncode != 0:
            logger.error(f"S3 upload failed: {proc.stderr[-500:]}")
        ul_time = time.perf_counter() - ul_start

        total_time = time.perf_counter() - start

        # Collect metrics
        merged_dir = os.path.join(work_dir, "merged")
        final_mosaic = os.path.join(merged_dir, "mosaic_merged.jpg")

        metrics = {
            "total_time_s": round(total_time, 2),
            "download_time_s": round(dl_time, 2),
            "stitch_time_s": round(stitch_time, 2),
            "merge_time_s": round(merge_time, 2),
            "upload_time_s": round(ul_time, 2),
            "chunk_size": chunk_size,
            "opencv_version": cv2.__version__ if OPENCV_AVAILABLE else "unknown",
            "is_cool": "/opt/cool" in (cv2.__file__ if OPENCV_AVAILABLE else ""),
            "final_mosaic_exists": os.path.exists(final_mosaic),
            "final_mosaic_size_bytes": os.path.getsize(final_mosaic) if os.path.exists(final_mosaic) else 0,
        }

        # Read canvas dimensions
        if os.path.exists(final_mosaic):
            img = cv2.imread(final_mosaic)
            if img is not None:
                metrics["canvas_width"] = img.shape[1]
                metrics["canvas_height"] = img.shape[0]
                metrics["canvas_mpx"] = round(img.shape[0] * img.shape[1] / 1e6, 1)
                gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
                metrics["content_pct"] = round(100.0 * (gray > 10).mean(), 1)

        # Cleanup
        import shutil
        shutil.rmtree(work_dir, ignore_errors=True)

        logger.info(f"Pipeline complete: {metrics}")
        return web.json_response(metrics)

    except Exception as e:
        logger.error(f"Pipeline failed: {e}", exc_info=True)
        return web.json_response({"error": str(e)}, status=500)


async def main():
    app = web.Application()
    app.router.add_get("/health", handle_health)
    app.router.add_post("/run-pipeline", handle_run_pipeline)
    runner = web.AppRunner(app)
    await runner.setup()
    site = web.TCPSite(runner, "0.0.0.0", 8080)
    await site.start()
    logger.info("Pipeline MCP server running on port 8080")
    await asyncio.Event().wait()


if __name__ == "__main__":
    asyncio.run(main())